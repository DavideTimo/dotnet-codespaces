@page "/settori"
@layout MainLayout

<PageTitle>Settori - MB Group Engineering & Services</PageTitle>

<section class="page-hero">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Settori</li>
            </ol>
        </nav>
        <h1 class="page-hero-title">Settori di Competenza</h1>
        <p class="page-hero-subtitle">Presenza consolidata nei principali mercati energetici e industriali</p>
    </div>
</section>

@foreach (var settore in settoriList)
{
    <section class="section-padding @(settore.BgClass)" id="@settore.Id">
        <div class="container">
            <div class="row align-items-center g-5 @(settore.Reverse ? "flex-lg-row-reverse" : "")">
                <div class="col-lg-6">
                    <div class="sector-detail-icon">
                        <i class="@settore.Icon"></i>
                    </div>
                    <span class="section-tag">@settore.Tag</span>
                    <h2 class="section-title">@settore.Title</h2>
                    <p class="text-muted mb-4">@settore.Description</p>
                    <div class="row g-2">
                        @foreach (var cap in settore.Capabilities)
                        {
                            <div class="col-12">
                                <div class="capability-item">
                                    <i class="fas fa-arrow-right text-accent me-2"></i>
                                    <span>@cap</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="sector-metrics">
                        @foreach (var m in settore.Metrics)
                        {
                            <div class="sector-metric-item">
                                <span class="sector-metric-value">@m.Value</span>
                                <span class="sector-metric-label">@m.Label</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
}

